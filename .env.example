# Copy to .env. Never commit the real .env file.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Official documentation model checked during implementation; override for your account/provider.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
AGENT_MAX_TOKENS=8192
AGENT_MAX_STEPS=40
AGENT_CONTEXT_CHARS=70000
AGENT_TIMEOUT=120
# Process-wide soft budget: checked before requests; parallel/in-flight calls may exceed it.
AGENT_TOKEN_BUDGET=200000
